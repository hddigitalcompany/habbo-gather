# Em desenvolvimento local, deixe assim (o servidor multiplayer roda em 127.0.0.1:1999):
NEXT_PUBLIC_REALTIME_HOST=127.0.0.1:1999

# Depois de publicar o servidor multiplayer (pasta server/) no Render,
# troque para o host que ele te der, por exemplo:
# NEXT_PUBLIC_REALTIME_HOST=habbo-gather-realtime.onrender.com

# --- Login/conta (Supabase, ver supabase/migrations/0001_accounts.sql) ---
# Crie um projeto em https://supabase.com (grátis) e pegue esses 3
# valores em Project Settings -> API. Rode o SQL de
# supabase/migrations/0001_accounts.sql no SQL Editor do projeto ANTES
# de usar login/cadastro.
#
# NEXT_PUBLIC_* vão pro navegador (a anon key é pública de propósito,
# protegida pelas políticas de RLS) -- SUPABASE_SERVICE_ROLE_KEY é
# SEGREDA, só o servidor (rotas em app/api/room/** e server/index.js)
# usa; NUNCA bota ela num NEXT_PUBLIC_*, nem comita ela em lugar
# nenhum.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
