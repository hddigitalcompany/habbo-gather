{
  "name": "habbo-gather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:server": "node server/index.js",
    "dev:assets": "node scripts/watchAvatarAssets.mjs",
    "dev": "concurrently -n next,server,assets -c blue,magenta,green \"npm:dev:next\" \"npm:dev:server\" \"npm:dev:assets\"",
    "sync-assets": "node scripts/syncAvatarAssets.mjs && node scripts/syncSkinAssets.mjs && node scripts/syncBeardAssets.mjs && node scripts/syncAccessoryAssets.mjs && node scripts/syncOutfitAssets.mjs && node scripts/syncFloorAssets.mjs",
    "build": "next build",
    "start": "next start",
    "start:server": "node server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "phaser": "^3.80.0",
    "partysocket": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "concurrently": "^8.2.0",
    "sharp": "^0.33.5"
  }
}
